<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Laba 1" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Laba 1">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="topbar">
      <%= link_to "Рибальський дворик", root_path, class: "brand" %>
      <span>
        <% if logged_in? %>
          <%= link_to "Кошик (#{current_cart.total_items})", cart_path, class: "cart-badge" %> ·
          <%= current_user.full_name %>
          <%= button_to "Вийти", logout_path, method: :delete, class: "btn-link", form: { class: "inline" } %>
        <% else %>
          <%= link_to "Вхід", login_path %> · <%= link_to "Реєстрація", register_path %>
        <% end %>
      </span>
    </nav>
    <% flash.each do |type, msg| %>
      <div class="flash flash-<%= type %>"><%= msg %></div>
    <% end %>
    <%= yield %>
    <footer class="site-footer">
      <div class="footer-info">
        <p><strong>Рибальський дворик</strong></p>
        <p>м. Київ, вул. Рибальська, 12</p>
        <p>Пн-Сб: 08:00 - 20:00, Нд: 09:00 - 17:00</p>
        <p>+38 (044) 123-45-67 · info@rybalskyi-dvoryk.ua</p>
      </div>
      <%= link_to "Зв'язатися з нами", contact_path, class: "btn-checkout" %>
    </footer>
  </body>
</html>
