<% content_for :title, "#{@product.name} — Рибальський дворик" %>
<%= link_to "← Назад", products_path, class: "back-link", data: { turbo: false }, onclick: "if (history.length > 1) { history.back(); return false; }" %>
<div class="product-detail">
  <div class="product-image large">
    <% if @product.image_url.present? %>
      <%= image_tag @product.image_url, alt: @product.name %>
    <% else %>
      <span class="placeholder">🎣</span>
    <% end %>
  </div>
  <div>
    <%= link_to @product.category.name, products_path(category_id: @product.category_id), class: "badge" %>
    <h1><%= @product.name %></h1>
    <p class="price big"><%= format_uah(@product.price) %></p>
    <p class="stock <%= @product.in_stock? ? 'in' : 'out' %>">
      <%= @product.in_stock? ? "В наявності: #{@product.stock_quantity} шт." : "Немає в наявності" %>
    </p>
    <% if @product.sku.present? %><p class="muted">Артикул: <%= @product.sku %></p><% end %>
    <p><%= @product.description %></p>
    <% if @product.in_stock? %><%= button_to "Додати до кошика", line_items_path(product_id: @product.id), class: "btn-checkout" %><% end %>
  </div>
</div>
