<% content_for :title, "Реєстрація" %>
<div class="auth-card">
  <h1>Реєстрація</h1>

  <%= form_with model: @user, url: users_path do |f| %>
    <% if @user.errors.any? %>
      <div class="flash flash-alert">
        <ul>
          <% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :first_name, "Ім'я" %>
      <%= f.text_field :first_name, required: true %>
    </div>
    <div class="field">
      <%= f.label :last_name, "Прізвище" %>
      <%= f.text_field :last_name, required: true %>
    </div>
    <div class="field">
      <%= f.label :email, "Електронна пошта" %>
      <%= f.email_field :email, required: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= f.label :phone, "Телефон" %>
      <%= f.telephone_field :phone, autocomplete: "tel" %>
    </div>
    <div class="field">
      <%= f.label :password, "Пароль" %>
      <%= f.password_field :password, required: true, minlength: 6, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Підтвердження пароля" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>
    <%= f.submit "Зареєструватися", class: "btn-submit" %>
  <% end %>

  <p class="auth-link">Вже є акаунт? <%= link_to "Увійти", login_path %></p>
</div>
