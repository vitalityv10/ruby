<div class="review">
  <div class="review-head">
    <strong><%= review.user.full_name %></strong>
    <span class="stars"><%= review.stars %></span>
    <span class="muted"><%= l(review.created_at.to_date) %></span>
    <% if logged_in? && (review.user_id == current_user.id || current_user.admin?) %>
      <%= button_to "Видалити", product_review_path(review.product_id, review), method: :delete, class: "btn-danger", form: { class: "inline" } %>
    <% end %>
  </div>
  <% if review.comment.present? %><p><%= review.comment %></p><% end %>
</div>
